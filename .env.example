# Supabase - browser/build-time
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase - server runtime
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
APP_URL=https://eu-passo.netlify.app

# AI - server runtime only
OPENAI_API_KEY=
AI_MODEL=gpt-5.6-luna

# Payments
# simulado = internal test plans; stripe = real checkout.
VITE_PAYMENTS_MODE=simulado
# Use sandbox for development/Deploy Previews. Switch to live only with real billing configured.
PAYMENTS_MODE=sandbox
VITE_PAYMENTS_CLIENT_TOKEN=
STRIPE_SANDBOX_SECRET_KEY=
STRIPE_LIVE_SECRET_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=

# Internal jobs
# Random server-only bearer secret used to invoke the Radar scheduled endpoint.
RADAR_CRON_SECRET=
